<!-- Oddech OD-1 · generated by tools/build_model.py on 2026-10-15 from the part list: edit the generator, not this file.
     Frames: REP 103 (x forward, y left, z up), metres, kilograms. Design targets for a robot not yet built. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo Harmonic: friction, sensors and model plugins -->
  <gazebo reference="wheel_left_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_right_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster_front_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="caster_rear_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar"><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.12414</max_angle></horizontal></scan><range><min>0.2</min><max>8.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></lidar></sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu"><topic>/imu</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>50</update_rate><always_on>true</always_on></sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint><right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.304</wheel_separation><wheel_radius>0.045</wheel_radius>
      <max_linear_velocity>0.3</max_linear_velocity><max_angular_velocity>1.6</max_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>mast_joint_1</joint_name><topic>/mast/cmd</topic><initial_position>0</initial_position><p_gain>600.0</p_gain><i_gain>60.0</i_gain><d_gain>80.0</d_gain><i_max>20</i_max><i_min>-20</i_min><cmd_max>60.0</cmd_max><cmd_min>-60.0</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>mast_joint_2</joint_name><topic>/mast/cmd</topic><initial_position>0</initial_position><p_gain>600.0</p_gain><i_gain>60.0</i_gain><d_gain>80.0</d_gain><i_max>20</i_max><i_min>-20</i_min><cmd_max>60.0</cmd_max><cmd_min>-60.0</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>mast_joint_3</joint_name><topic>/mast/cmd</topic><initial_position>0</initial_position><p_gain>600.0</p_gain><i_gain>60.0</i_gain><d_gain>80.0</d_gain><i_max>20</i_max><i_min>-20</i_min><cmd_max>60.0</cmd_max><cmd_min>-60.0</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>mast_joint_4</joint_name><topic>/mast/cmd</topic><initial_position>0</initial_position><p_gain>600.0</p_gain><i_gain>60.0</i_gain><d_gain>80.0</d_gain><i_max>20</i_max><i_min>-20</i_min><cmd_max>60.0</cmd_max><cmd_min>-60.0</cmd_min></plugin>
