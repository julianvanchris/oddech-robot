<?xml version="1.0"?>
<!-- Oddech OD-1 · generated by tools/build_model.py on 2026-10-15 from the website's room model: edit the generator, not this file.
     Frames: REP 103 (x forward, y left, z up), metres, kilograms. Design targets for a robot not yet built. -->
<sdf version="1.10">
  <world name="oddech_flat">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.55 0.56 0.6 1</ambient><background>0.06 0.11 0.18 1</background><shadows>true</shadows><grid>false</grid></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>4 3 12 0 0 0</pose><diffuse>0.85 0.83 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.35 0.25 -0.9</direction></light>
    <light type="point" name="lamp"><pose>4 3 2.5 0 0 0</pose><diffuse>0.5 0.48 0.45 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        <material><ambient>0.62 0.6 0.56 1</ambient><diffuse>0.82 0.79 0.74 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link></model>
    <include><uri>model://oddech_flat</uri><name>flat</name><pose>0 0 0 0 0 0</pose></include>
    <include><uri>model://oddech</uri><name>oddech</name><pose>6.6 3.0 0 0 0 3.14159</pose></include>
    <!-- keyboard: open the Key Publisher plugin (top-right menu), then the arrows drive, space stops, 1 2 3 set the nose to 0.40, 1.10, 1.60 m -->
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">16777235</match></input><output type="gz.msgs.Twist" topic="/cmd_vel">linear: {x: 0.25}, angular: {z: 0.0}</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">16777237</match></input><output type="gz.msgs.Twist" topic="/cmd_vel">linear: {x: -0.15}, angular: {z: 0.0}</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">16777234</match></input><output type="gz.msgs.Twist" topic="/cmd_vel">linear: {x: 0.0}, angular: {z: 1.0}</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">16777236</match></input><output type="gz.msgs.Twist" topic="/cmd_vel">linear: {x: 0.0}, angular: {z: -1.0}</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">32</match></input><output type="gz.msgs.Twist" topic="/cmd_vel">linear: {x: 0.0}, angular: {z: 0.0}</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">49</match></input><output type="gz.msgs.Double" topic="/mast/cmd">data: 0.0</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">50</match></input><output type="gz.msgs.Double" topic="/mast/cmd">data: 0.175</output></plugin>
    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher"><input type="gz.msgs.Int32" topic="/keyboard/keypress"><match field="data">51</match></input><output type="gz.msgs.Double" topic="/mast/cmd">data: 0.3</output></plugin>
  </world>
</sdf>
